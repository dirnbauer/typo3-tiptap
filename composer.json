{
  "name": "in2code/typo3-tiptap",
  "type": "typo3-cms-extension",
  "description": "TipTap rich text editor integration for TYPO3 CMS 14.",
  "license": ["GPL-2.0-or-later"],
  "keywords": ["TYPO3 CMS"],
  "authors": [
    {
      "name": "In2code GmbH",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.3.0",
    "typo3/cms-backend": "^14.0",
    "typo3/cms-core": "^14.0"
  },
  "suggest": {
    "typo3/cms-workspaces": "Enable staged editorial workflows and workspace previews for TipTap fields."
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^11.5",
    "typo3/cms-extensionmanager": "^14.0",
    "typo3/cms-fluid-styled-content": "^14.0",
    "typo3/cms-install": "^14.0",
    "typo3/cms-workspaces": "^14.0"
  },
  "autoload": {
    "psr-4": {
      "In2code\\Typo3TipTap\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "In2code\\Typo3TipTap\\Tests\\": "Tests/"
    }
  },
  "scripts": {
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist",
    "test:unit": "phpunit --configuration=phpunit.xml.dist"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "typo3_tiptap",
      "cms-package-dir": "{$vendor-dir}/typo3/cms",
      "web-dir": ".Build/public"
    }
  },
  "config": {
    "vendor-dir": ".Build/vendor",
    "bin-dir": ".Build/bin",
    "sort-packages": true,
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    }
  }
}
